#!/usr/bin/env bash

set -Eeuo pipefail

project_name="osc"
container_name="${ZC_CONTAINER_NAME:-${project_name}-build}"
container_hostname="${ZC_CONTAINER_HOSTNAME:-${project_name}-build}"
image_name="${ZC_IMAGE:-${project_name}-build}"
container_home="${ZC_CONTAINER_HOME:-/work}"
workspace_dir="${ZC_HOST_WORKDIR:-$HOME/OSC}"

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  zc                         Enter the container using ZC_SHELL
  zc <command> [args...]     Run a command inside the container
  zc build-image             Build the container image
  zc rm                      Stop and remove the container
  zc rebuild                 Recreate the container using the existing image
  zc rebuild-all             Rebuild the image and recreate the container
  zc help                    Show this help message

Environment:
  ZC_CONTAINER_RUNTIME       Runtime: podman or docker (auto-detected)
  ZC_CONTAINER_NAME          Container name (default: $project_name-build)
  ZC_CONTAINER_HOSTNAME      Container hostname (default: $project_name-build)
  ZC_CONTAINER_HOME          Container home directory (default: /work)
  ZC_HOST_WORKDIR            Host workspace directory (default: $HOME/workspace/$project_name)
  ZC_HOST_SDK_DIR            Host Zephyr SDK directory (default: $HOME/workspace/$project_name/tools/$project_name-sdk)
  ZC_SHELL                   Shell used when entering (default: /usr/bin/fish)
  ZC_IMAGE                   Image name (default: $project_name-build)
EOF
}

container_runtime="${ZC_CONTAINER_RUNTIME:-}"
if [[ -n "$container_runtime" ]]; then
    command -v "$container_runtime" >/dev/null 2>&1 || die \
        "container runtime '$container_runtime' is not installed or not in PATH"
elif command -v podman >/dev/null 2>&1; then
    container_runtime=podman
elif command -v docker >/dev/null 2>&1; then
    container_runtime=docker
else
    die "neither podman nor docker is installed or in PATH"
fi

container_exists() {
    "$container_runtime" container inspect "$1" >/dev/null 2>&1
}

image_exists() {
    "$container_runtime" image inspect "$1" >/dev/null 2>&1
}

build_image() {
    printf 'Building image %s...\n' "$image_name"
    "$container_runtime" build --tag "$image_name" "$workspace_dir"
}

remove_container() {
    if ! container_exists "$container_name"; then
        return
    fi

    container_status="$("$container_runtime" container inspect \
        --format '{{.State.Status}}' "$container_name")"
    if [[ "$container_status" == "running" ]]; then
        printf 'Stopping container %s...\n' "$container_name"
        "$container_runtime" container stop -t 1 "$container_name" >/dev/null
    fi

    printf 'Removing container %s...\n' "$container_name"
    "$container_runtime" container rm "$container_name" >/dev/null
}

remove_image() {
    if image_exists "$image_name"; then
        printf 'Removing image %s...\n' "$image_name"
        "$container_runtime" image rm "$image_name"
    fi
}

create_container() {
    image_exists "$image_name" || die \
        "image '$image_name' does not exist; run '$0 build-image' first"

    if ! container_exists "$container_name"; then
        printf 'Creating container %s from image %s...\n' \
            "$container_name" "$image_name"

        create_args=(
            --name "$container_name" \
            --hostname "$container_hostname" \
	    --network host \
            --device=/dev/bus/usb:/dev/bus/usb \
            --volume /dev/bus/usb:/dev/bus/usb \
            --volume "${workspace_dir}:${container_home}:z" \
            --workdir "$container_home"
        )
        if [[ "$container_runtime" == podman ]]; then
            create_args+=(--userns=keep-id)
        fi
        "$container_runtime" create \
            "${create_args[@]}" \
            "$image_name" sleep infinity >/dev/null
    fi
}

start_container() {
    container_status="$("$container_runtime" container inspect \
        --format '{{.State.Status}}' "$container_name")"
    if [[ "$container_status" != "running" ]]; then
        printf 'Starting container %s...\n' "$container_name"
        "$container_runtime" start "$container_name" >/dev/null
    fi
}

run_in_container() {
    create_container
    start_container

    if (($# == 0)); then
        shell="${ZC_SHELL:-/usr/bin/fish}"
        exec "$container_runtime" exec -it "$container_name" "$shell"
    fi

    exec "$container_runtime" exec -it "$container_name" "$@"
}

case "${1:-}" in
    help|-h|--help)
        (($# == 1)) || die "help does not accept arguments"
        usage
        ;;
    build-image)
        (($# == 1)) || die "build-image does not accept arguments"
        build_image
        ;;
    rm)
        (($# == 1)) || die "rm does not accept arguments"
        remove_container
        ;;
    rebuild)
        (($# == 1)) || die "rebuild does not accept arguments"
        remove_container
        create_container
        ;;
    rebuild-all)
        (($# == 1)) || die "rebuild-all does not accept arguments"
        remove_container
        remove_image
        build_image
        create_container
        ;;
    *)
        run_in_container "$@"
        ;;
esac
